# ── Drone MCP Project — environment configuration ──────────────────────────────
# Copy to ".env" and adjust for your network / machine.  All values have sane
# local defaults, so an empty .env works for a single-machine demo.

# Network -----------------------------------------------------------------------
DRONE_HOST=0.0.0.0
DRONE_PORT=8000

# Ollama (local LLM brain) ------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# MODEL SEÇENEKLERI:
#   llava:7b          → 4.7 GB — kurulu, temel görsel anlama (varsayılan)
#   qwen2.5vl:7b      → 5.0 GB — ÖNERİLEN: engel tespiti için çok daha iyi
#                                 ollama pull qwen2.5vl:7b
#   qwen2.5vl:32b     → 20 GB  — en güçlü, sunum için en etkileyici
#                                 ollama pull qwen2.5vl:32b
#   llama3.2-vision:11b → 8 GB → ollama pull llama3.2-vision:11b (eski Ollama'da sorun vardı)
OLLAMA_MODEL=llava:7b
# OLLAMA_MODEL=qwen2.5vl:7b   ← engel tespiti için bu satırı aktifleştir
OLLAMA_TIMEOUT_S=60

# Agentic mode (Phase 4) --------------------------------------------------------
AGENT_USE_VISION=true
AGENT_VISION_MAX_EDGE=512
AGENT_OUTPUT_RETRIES=2

# Short-term memory (multi-frame trend) -----------------------------------------
# How many recent telemetry samples feed the tilt-trend line in the prompt.
# 1 disables the trend (single-frame behaviour).
AGENT_MEMORY_FRAMES=5

# Hybrid mode (reflex + deliberation) -------------------------------------------
# Fast reflex (rule engine) cadence; the LLM deliberates asynchronously and its
# verdict is treated as stale after the TTL, handing control back to the reflex.
HYBRID_REFLEX_HZ=10
HYBRID_DELIBERATION_TTL_S=5

# Rule-based thresholds (Phase 3) -----------------------------------------------
TILT_WARNING_DEG=15
TILT_DANGER_DEG=30
MOTOR_DEFAULT=50
MOTOR_STABILIZE=75
MOTOR_EMERGENCY=100

# Logging (Phase 5) -------------------------------------------------------------
ENABLE_FILE_LOGGING=true
# DECISION_LOG_FILE=logs/decisions.jsonl
